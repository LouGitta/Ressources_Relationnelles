# ==================== VARIABLES D'ENVIRONNEMENT ====================
# Copier ce fichier en .env et remplir les valeurs pour votre environnement
# NE JAMAIS commiter le fichier .env réel (ajouter à .gitignore)

# ==================== CONFIGURATION DE PROFIL ====================
SPRING_PROFILES_ACTIVE=dev

# ==================== BASE DE DONNÉES (Production uniquement) ====================
# Format: jdbc:mysql://host:port/database_name?serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/ressources_relationnelles?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# ==================== SERVEUR ====================
SERVER_PORT=8080

# ==================== SSL/HTTPS (Production) ====================
SSL_ENABLED=false
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=keystore_password_here

# ==================== APPLICATION ====================
DEV_MODE=false
