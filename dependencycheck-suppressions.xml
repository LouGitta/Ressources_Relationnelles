<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://dependencycheck.github.io/dependency-matching/dependency-suppression.1.3.xsd">
    <!-- Suppress Spring Security 7.0.3 False Positive CVE-2018-1258 -->
    <suppress>
        <notes><![CDATA[
        Suppress false positive CVE-2018-1258 for Spring Security Core 7.x since it only affects version 5.0.5 and older.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring-security-.*$</packageUrl>
        <cve>CVE-2018-1258</cve>
    </suppress>

    <!-- Suppress Node.js/NPM devDependencies and build tools in the MobileApp directory -->
    <!-- These are only used during the build phase/testing and are not packaged into the production bundle. -->
    <suppress>
        <notes><![CDATA[Suppress babel plugin transform modules systemjs which is a dev/build tool]]></notes>
        <packageUrl regex="true">^pkg:npm/%40babel.*plugin-transform-modules-systemjs.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress xmldom which is a transient dev dependency in the mobile project]]></notes>
        <packageUrl regex="true">^pkg:npm/%40xmldom.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress minimatch dev dependency]]></notes>
        <packageUrl regex="true">^pkg:npm/minimatch@.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress shell-quote dev dependency]]></notes>
        <packageUrl regex="true">^pkg:npm/shell-quote@.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress tmp dev dependency]]></notes>
        <packageUrl regex="true">^pkg:npm/tmp@.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress uuid dev dependency]]></notes>
        <packageUrl regex="true">^pkg:npm/uuid@.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>

    <suppress>
        <notes><![CDATA[Suppress vite dev dependency / build tool]]></notes>
        <packageUrl regex="true">^pkg:npm/vite@.*$</packageUrl>
        <vulnerabilityName regex="true">^GHSA-.*$</vulnerabilityName>
    </suppress>
</suppressions>
